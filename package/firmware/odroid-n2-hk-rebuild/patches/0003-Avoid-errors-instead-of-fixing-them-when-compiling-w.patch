From 5236f6d10764897c8fbfabcbbe766bac316f0dcb Mon Sep 17 00:00:00 2001
From: Hubai Szabolcs <hubai@astron.hu>
Date: Wed, 15 Sep 2021 00:44:13 +0200
Subject: [PATCH 3/4] Avoid errors instead of fixing them when compiling with
 gcc 10

The code compiles for Linaro GCC 4.8.3, but I'd like to use gcc-arm 10.2

gcc version 10.2.1 20201103 (GNU Toolchain for the A-profile Architecture 10.2-2020.11 (arm-10.16))

Signed-off-by: Szabolcs Hubai <szab.hu@gmail.com>
---
 Makefile | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 730e8d752f..58a76c73a3 100644
--- a/Makefile
+++ b/Makefile
@@ -356,7 +356,10 @@ CHECKFLAGS     := -D__linux__ -Dlinux -D__STDC__ -Dunix -D__unix__ \
 
 KBUILD_CPPFLAGS := -D__KERNEL__ -D__UBOOT__
 
-KBUILD_CFLAGS   := -Wall -Wstrict-prototypes \
+# FIX ME for GCC 10.2
+KBUILD_CFLAGS   := -Wno-error=misleading-indentation -Wno-error=int-conversion \
+		   -Wno-error=address-of-packed-member -Wno-error=int-in-bool-context \
+		   -Wall -Wstrict-prototypes \
 		   -Wno-format-security \
 		   -fno-builtin -ffreestanding
 KBUILD_AFLAGS   := -D__ASSEMBLY__
-- 
2.25.1

